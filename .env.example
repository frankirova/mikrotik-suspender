# ── MikroTik ────────────────────────────────────────────
USER_MIKROTIK=admin
PASS_MIKROTIK=your_password_here

# ── Data ────────────────────────────────────────────────
# Path to the CSV file with client IPs and names
# (required columns: ip, nombre)
CSV_PATH=./data/clientes.csv

# Path to the SQLite database for stored option IPs
OPTIONS_DB_PATH=./data/options.db

# Directory where runtime data lives (auto-created on startup)
DATA_DIR=./data

# ── CORS ────────────────────────────────────────────────
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://localhost:8000

# ── Server ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# -- Authentication (optional) -----------------------------
# When set, all sensitive endpoints require:
#   Authorization: Bearer <API_KEY>
# When unset, the API runs WITHOUT authentication (dev mode, with a
# loud WARNING logged at startup). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#API_KEY=
